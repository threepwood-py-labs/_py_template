name: CI

on:
  push:
    branches: [develop, main, master]
  pull_request:
    branches: [develop, main, master]
  workflow_dispatch:

concurrency:
  group: {% raw %}${{ github.workflow }}-${{ github.ref }}{% endraw %}
  cancel-in-progress: true

jobs:
  lint:
    name: Lint & Types
    runs-on: windows-latest
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@v4

      - name: Install uv
        uses: astral-sh/setup-uv@v3
        with:
          enable-cache: true

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version-file: .python-version

      - name: Install Hatch
        run: uv tool install hatch

      - name: Run linting
        run: hatch run lint:check

      - name: Run formatting check
        run: hatch run lint:fmt

      - name: Run type checking
        run: hatch run lint:types

      - name: Run dependency checks
        run: hatch run lint:deps

      - name: Advisory dead code checks
        run: hatch run lint:deadcode
        continue-on-error: true

      - name: Advisory complexity checks
        run: hatch run lint:complexity
        continue-on-error: true

      - name: Run policy checks
        run: hatch run lint:policy

  test:
    name: Test (Python {% raw %}${{ matrix.python-version }}{% endraw %})
    runs-on: windows-latest
    timeout-minutes: 30
    env:
      USERPROFILE: {% raw %}${{ runner.temp }}{% endraw %}\{{ project_name }}-user
      APPDATA: {% raw %}${{ runner.temp }}{% endraw %}\{{ project_name }}-user\AppData\Roaming
      LOCALAPPDATA: {% raw %}${{ runner.temp }}{% endraw %}\{{ project_name }}-user\AppData\Local
      TEMP: {% raw %}${{ runner.temp }}{% endraw %}\{{ project_name }}-temp
      TMP: {% raw %}${{ runner.temp }}{% endraw %}\{{ project_name }}-temp
      QT_QPA_PLATFORM: offscreen
    strategy:
      fail-fast: false
      matrix:
        python-version: ["3.13"]

    steps:
      - uses: actions/checkout@v4

      - name: Install uv
        uses: astral-sh/setup-uv@v3
        with:
          enable-cache: true

      - name: Set up Python {% raw %}${{ matrix.python-version }}{% endraw %}
        uses: actions/setup-python@v5
        with:
          python-version: {% raw %}${{ matrix.python-version }}{% endraw %}

      - name: Install Hatch
        run: uv tool install hatch

      - name: Prepare isolated test profile
        shell: pwsh
        run: |
          $paths = @(
            $env:USERPROFILE
            $env:APPDATA
            $env:LOCALAPPDATA
            $env:TEMP
          )
          foreach ($path in $paths) {
            New-Item -ItemType Directory -Force -Path $path | Out-Null
          }

      - name: Run tests with coverage
        run: hatch run test-cov

      - name: Upload coverage to Codecov
        uses: codecov/codecov-action@v4
        if: {% raw %}${{ matrix.python-version == '3.13' }}{% endraw %}
        with:
          files: coverage.xml
          fail_ci_if_error: false
